# Twitch OAuth - copy to .env and add your credentials
# Get from https://dev.twitch.tv/console/apps
# OAuth redirect URL: http://localhost:3000/oauth/callback

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Twitch logins allowed to use !killcommand (comma-separated, case-insensitive).
# VirtualDeck must run on the same PC as Streamlabs Desktop.
VD_KILLCOMMAND_USERS=techno,defaultmayhem,sarah

# Optional: Streamlabs local JSON-RPC TCP (defaults match Streamlabs Desktop)
# VD_STREAMLABS_TCP_HOST=127.0.0.1
# VD_STREAMLABS_TCP_PORT=28194

# Licensing (Lemon Squeezy — public builds use mock until store is live)
# VD_LICENSE_PROVIDER=mock
# VD_LICENSE_PROVIDER=lemonsqueezy
# LEMONSQUEEZY_STORE_ID=501850
# LEMONSQUEEZY_PRODUCT_ID=1453199
# LEMONSQUEEZY_VARIANT_ID=2268234
# VD_LICENSE_PURCHASE_URL=https://virtualdeckapp.lemonsqueezy.com/checkout/buy/...
# VD_LICENSE_MOCK_PREFIXES=VD-MOCK-,VDTEST-

# JARVIS Tool API settings
# Port for JARVIS API server (default: 8091)
JARVIS_PORT=8091

# Host to bind to (default: 127.0.0.1 for localhost-only access)
JARVIS_HOST=127.0.0.1

# Optional: Auth token for JARVIS API
# If set, all API requests must include X-Jarvis-Token header
# If not set, API is open but only accessible from localhost
JARVIS_TOKEN=your-secret-token-here
