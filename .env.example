# Twitch logins allowed to use !killcommand (comma-separated, case-insensitive).
# VirtualDeck must run on the same PC as Streamlabs Desktop.
VD_KILLCOMMAND_USERS=techno,defaultmayhem,sarah

# Optional: Streamlabs local JSON-RPC TCP (defaults match Streamlabs Desktop)
# VD_STREAMLABS_TCP_HOST=127.0.0.1
# VD_STREAMLABS_TCP_PORT=28194
