{
  "name": "virtualdeck",
  "version": "1.1.1",
  "description": "A virtual deck application built with Electron",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prepare-build": "node prepare-build.js",
    "prepare-build:no-raven": "node -e \"process.env.SKIP_RAVEN='1'; require('./prepare-build').runPrepareBuild()\"",
    "test:prepare-build": "node test-prepare-build.js",
    "stage-raven": "powershell -ExecutionPolicy Bypass -File scripts/stage-raven-runtime.ps1",
    "dist": "npm run prepare-build:no-raven && electron-builder",
    "build:win": "npm run prepare-build:no-raven && electron-builder --win",
    "build:win:with-raven": "npm run stage-raven && npm run prepare-build && electron-builder --win"
  },
  "keywords": [
    "electron",
    "virtual",
    "deck",
    "desktop"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.virtualdeck.app",
    "productName": "VirtualDeck",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "raven-host.js",
      "vtuber-manager.js",
      "streamlabs-tcp.js",
      "jarvis-server.js",
      "jarvis-tools.js",
      "lib/**/*",
      "config.json",
      "public/**/*",
      "!public/*.meld-backup",
      "overlays/**/*",
      "skins/**/*",
      "TwitchConnected/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "extra/raven",
        "to": "raven"
      }
    ],
    "mac": {
      "target": []
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/VD.gif",
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VirtualDeck"
    }
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "electron-updater": "^6.6.2",
    "fs-extra": "^11.3.0",
    "node-fetch": "^2.7.0",
    "tmi.js": "^1.8.5",
    "windows-shortcuts": "^0.1.6",
    "ws": "^8.18.0"
  }
}
