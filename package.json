{
  "name": "virtualdeck",
  "version": "1.1.5",
  "description": "A virtual deck application built with Electron",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prepare-build": "node prepare-build.js",
    "dist": "npm run prepare-build && electron-builder",
    "build:win": "npm run prepare-build && electron-builder --win"
  },
  "keywords": [
    "electron",
    "virtual",
    "deck",
    "desktop"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jontslater/virtualdeck.git"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.virtualdeck.app",
    "productName": "VirtualDeck",
    "publish": {
      "provider": "github",
      "owner": "jontslater",
      "repo": "virtualdeck",
      "releaseType": "release"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "config.json",
      "public/**/*",
      "overlays/**/*",
      "skins/**/*",
      "TwitchConnected/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "target": []
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/VD.gif",
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VirtualDeck"
    }
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "electron-updater": "^6.6.2",
    "fs-extra": "^11.3.0",
    "tmi.js": "^1.8.5",
    "windows-shortcuts": "^0.1.6"
  }
}
